# Dependencias
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
dist-electron/
release/
out/
.electron-builder-cache/
.electron-builder-cache.bak/
# Cache local de electron-builder (scripts/package_win.cjs) — evita el bug de
# symlinks de winCodeSign en Windows sin admin. Ver scripts/eb-shim/7za.cmd
.eb-cache/

# Python
python_backend/__pycache__/
python_backend/*/__pycache__/
python_backend/.venv/
python_backend/venv/
# CPython portable embebido (433 MB, se baja solo con scripts/build-portable-python.ps1)
python_backend/.py/
.pybuild/
# modelos whisper descargados
python_backend/models/
# binarios de llama.cpp descargados (se bajan solos en el primer uso)
python_backend/bin/
python_backend/*.pyc
python_backend/*.pyo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local env
.env
.env.local
.env.*.local

# Uploads/outputs (audio temporal)
uploads/
outputs/

# Tmp
tmp/
temp/
.cache/

# TS build info
*.tsbuildinfo
vite.config.js
vite.config.d.ts

# Archivos temporales de diagnostico
*.tmp
*.tmp.old
*.tmp.bak
.cleanup_*

# Diag scripts
scripts/diag_*.cjs
scripts/diag_*.js
